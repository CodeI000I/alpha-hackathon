# Host DSN for `make server` / `make worker`; Compose uses its internal postgres hostname.
DATABASE_URL=postgres://app:app@localhost:5432/alpha?sslmode=disable
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=alpha
HTTP_ADDR=:8080
SESSION_COOKIE_SECURE=false
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfs12345
S3_BUCKET=company-files
# Адрес analytics API для локально запущенного Go backend.
ORCHESTRATOR_URL=http://localhost:8090
ORCHESTRATOR_TIMEOUT=5m
INGEST_PERIOD=15m
RANK_MAX_PER_RUN=20
RANK_LOOKBACK=504h
NEWS_COLDSTART_ENABLED=true

# Compose reads .env for substitutions. Copy this file to .env; replace the local-only service token before sharing a network.
# AI_API_KEY is needed only for model-backed analytics work; reads and startup work without it.
AI_API_KEY=
AI_BASE_URL=https://changellenge.up.railway.app/v1
AI_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash
AI_DECISION_MODEL=
AI_ANALYSIS_MODEL=
AI_SYNTHESIS_MODEL=
AI_CHAT_MODEL=
# Allowed: google/gemma-4-26b-a4b-it, z-ai/glm-5.3-flash,
# qwen/qwen3.6-35b-a3b, deepseek/deepseek-v4.1-flash,
# qwen/qwen3-vl-30b-a3b-instruct, moonshotai/kimi-k2.6
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_RETRY_DELAY_SECONDS=15
AI_MAX_CONCURRENT_REQUESTS=2
AI_REQUESTS_PER_MINUTE=20
AI_MAX_OUTPUT_TOKENS=1800
AI_MAX_INPUT_CHARS=32000
AI_RETRIEVAL_TOP_K=8
AI_RELEVANCE_LOW=0.35
AI_RELEVANCE_HIGH=0.7
AI_POLICY_VERSION=bank-analysis-v1
AI_DB_PATH=orchestrator/data/analytics.sqlite3
# Required for Go → analytics authorization; never expose this token in frontend code.
AI_SERVICE_TOKEN=local-dev-token
ANALYTICS_POLL_SECONDS=5
# Required for the private file-download bridge; never expose this token in frontend code.
INTERNAL_API_TOKEN=local-internal-dev-token
# Host URL for the Python worker. Compose overrides it with its internal server address.
BACKEND_URL=http://localhost:8080
# Leave parser database URLs empty to keep parser migrations and source processing disabled.
COMPOSE_PARSER_DATABASE_URL=
PARSER_DATABASE_URL=
PARSER_CONNECT_TIMEOUT_SECONDS=5
PARSER_STATEMENT_TIMEOUT_MS=10000
PARSER_LEASE_SECONDS=150
PARSER_MAX_ATTEMPTS=3
PARSER_POLL_SECONDS=900
# Source fetching and parser writes stay disabled until explicitly enabled.
PARSER_CBR_ALLOW_FETCH=false
PARSER_CBR_ALLOW_PERSIST=false
PARSER_CBR_POLICY_VERSION=cbr-press-v1
PARSER_CBR_USER_AGENT=AlphaHackathon/1.0
PARSER_CBR_MAX_ITEMS=10
PARSER_CBR_MAX_RESPONSE_BYTES=2000000
PARSER_CBR_MAX_TOTAL_BYTES=5000000
PARSER_CBR_REQUEST_TIMEOUT_SECONDS=10
PARSER_CBR_JOB_TIMEOUT_SECONDS=120
PARSER_CBR_MIN_INTERVAL_SECONDS=1

# Optional typed-decision provider. Hosted Jev needs the TypeSafe key; a local
# Clef System One server normally uses no key and a loopback URL.
AI_SYSTEMONE_URL=
AI_SYSTEMONE_MODEL=jev-latest
AI_SYSTEMONE_API_KEY=
AI_SYSTEMONE_TIMEOUT_SECONDS=10
AI_SYSTEMONE_COOLDOWN_SECONDS=60

# Native Python commands use the host DSNs below. Compose constructs the same database URLs with its `postgres` service name.
# Analytics uses its own schema in the same PostgreSQL database as the Go backend.
ANALYTICS_DATABASE_URL=postgres://app:app@localhost:5432/alpha?sslmode=disable
ANALYTICS_BACKEND_DATABASE_URL=postgres://app:app@localhost:5432/alpha?sslmode=disable
ANALYTICS_OBJECT_DIR=orchestrator/data/documents
ANALYTICS_CHECKPOINTS=true
ANALYTICS_OPERATIONAL_RETENTION_DAYS=30
ANALYTICS_TOP_K=12
ANALYTICS_GRAPH_DEPTH=2
ANALYTICS_GRAPH_ENABLED=true
# Advisory System One/LLM triage before grounded assessment; no filtering by its verdict.
# URL alone does not enable this step. Empty AI_SYSTEMONE_URL uses the LLM fallback.
ANALYTICS_TRIAGE_ENABLED=false
ANALYTICS_DEBOUNCE_SECONDS=30
ANALYTICS_MAX_JOB_ATTEMPTS=3
# lexical is a usable baseline. local loads an explicitly prepared model directory.
EMBEDDING_BACKEND=lexical
EMBEDDING_MODEL_PATH=orchestrator/data/embedding-model
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_VERSION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
ANALYTICS_GRAPHIFY_ENABLED=false
# Prepared normalized Graphify JSON for this exact document revision; no Graphify execution.
ANALYTICS_GRAPHIFY_JSON_PATH=
# OCR uses this local default directory; see analytics.prepare_assets --ocr.
