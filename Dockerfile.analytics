FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends tesseract-ocr \
 && rm -rf /var/lib/apt/lists/*

COPY orchestrator/requirements.txt /app/orchestrator/requirements.txt
COPY orchestrator/analytics/requirements.txt /app/orchestrator/analytics/requirements.txt
RUN pip install --no-cache-dir -r /app/orchestrator/analytics/requirements.txt

COPY orchestrator /app/orchestrator
COPY parser_service /app/parser_service
RUN python -m orchestrator.analytics.prepare_assets --ocr \
 && useradd --uid 10001 --create-home app \
 && mkdir -p /data/documents \
 && chown -R app:app /app /data
ENV PYTHONPATH=/app TESSDATA_PREFIX=/app/orchestrator/data/tessdata
EXPOSE 8090
USER 10001:10001
CMD ["uvicorn", "orchestrator.analytics.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8090"]
