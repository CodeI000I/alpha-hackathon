DATABASE_URL=postgres://app:app@localhost:5432/alpha?sslmode=disable
HTTP_ADDR=:8080
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfs12345
S3_BUCKET=company-files
# Адрес Jev (TypeSafe AI), модели, которая решает, что попадёт в ленту. Пусто = заглушка по ключевым словам.
JEV_URL=
INGEST_PERIOD=15m

# Python orchestrator reads .env.local automatically. Process environment wins.
# Copy this file to .env.local and fill only AI_API_KEY for CLI usage.
AI_API_KEY=
AI_BASE_URL=https://changellenge.up.railway.app/v1
AI_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash
AI_DECISION_MODEL=
AI_ANALYSIS_MODEL=
AI_SYNTHESIS_MODEL=
AI_CHAT_MODEL=
# Allowed: google/gemma-4-26b-a4b-it, z-ai/glm-5.3-flash,
# qwen/qwen3.6-35b-a3b, deepseek/deepseek-v4.1-flash,
# qwen/qwen3-vl-30b-a3b-instruct, moonshotai/kimi-k2.6
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_RETRY_DELAY_SECONDS=15
AI_MAX_CONCURRENT_REQUESTS=2
AI_REQUESTS_PER_MINUTE=20
AI_MAX_OUTPUT_TOKENS=1800
AI_MAX_INPUT_CHARS=32000
AI_RETRIEVAL_TOP_K=8
AI_RELEVANCE_LOW=0.35
AI_RELEVANCE_HIGH=0.7
AI_POLICY_VERSION=bank-analysis-v1
AI_DB_PATH=orchestrator/data/analytics.sqlite3
# Required only for internal HTTP API; never expose this token in frontend code.
AI_SERVICE_TOKEN=

# Optional typed-decision provider. Hosted Jev needs the TypeSafe key; a local
# Clef System One server normally uses no key and a loopback URL.
AI_SYSTEMONE_URL=
AI_SYSTEMONE_MODEL=jev-latest
AI_SYSTEMONE_API_KEY=
AI_SYSTEMONE_TIMEOUT_SECONDS=10
AI_SYSTEMONE_COOLDOWN_SECONDS=60

# Isolated analytics prototype; never falls back to backend DATABASE_URL or SQLite.
# Use a dedicated local/test database until integration is agreed with the team.
ANALYTICS_DATABASE_URL=
ANALYTICS_OBJECT_DIR=orchestrator/data/documents
ANALYTICS_CHECKPOINTS=true
ANALYTICS_OPERATIONAL_RETENTION_DAYS=30
ANALYTICS_TOP_K=12
ANALYTICS_GRAPH_DEPTH=2
ANALYTICS_GRAPH_ENABLED=true
# Advisory System One/LLM triage before grounded assessment; no filtering by its verdict.
# URL alone does not enable this step. Empty AI_SYSTEMONE_URL uses the LLM fallback.
ANALYTICS_TRIAGE_ENABLED=false
ANALYTICS_DEBOUNCE_SECONDS=30
ANALYTICS_MAX_JOB_ATTEMPTS=3
# lexical is a usable baseline. local loads an explicitly prepared model directory.
EMBEDDING_BACKEND=lexical
EMBEDDING_MODEL_PATH=orchestrator/data/embedding-model
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_VERSION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
ANALYTICS_GRAPHIFY_ENABLED=false
# Prepared normalized Graphify JSON for this exact document revision; no Graphify execution.
ANALYTICS_GRAPHIFY_JSON_PATH=
# OCR uses this local default directory; see analytics.prepare_assets --ocr.
